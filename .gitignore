# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
venv/
__pycache__/
*.pyc

# --- Corpus PDFs: copyrighted publisher papers, never redistribute ---
# Blanket rule so a new subdirectory can never leak them again.
*.pdf
# Exception: our own generated figures/output live in results/.
!results/*.pdf

data/raw_pdfs/
data/removed_pdfs/
data/labels/

# --- Cached full text of those PDFs: same redistribution problem ---
data/extracted_text/
**/extracted_text/
# The references-stripped copy (scripts/19_strip_references.py) is still
# the papers' full text -- same redistribution problem, and the two rules
# above do not match a directory whose name only starts with the prefix.
data/extracted_text_stripped/
**/extracted_text_stripped/

# --- Zotero metadata + local DB ---
data/zotero_meta.jsonl
data/zotero_manifest.csv
*.sqlite
*.db
# WAL mode (db.connect) leaves these beside the database; they are not matched by *.db
*.db-shm
*.db-wal

# --- Tooling / scratch ---
.claude/
~$*
*.xlsx
*.xls
*.xlsm
*.aux
*.log

Research Claude Plan (Outline)*

# Working notes for Deb, not for the repo.
Deb.md

# Source manuscripts supplied by the study team, not ours to redistribute.
# Ignore02.pdf is the Glueck & Muller paper this project replicates.
Ignore0*
