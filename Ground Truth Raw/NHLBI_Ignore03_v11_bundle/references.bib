@article{dongPowerUpToolCalculating2013,
	title = {{PowerUp}!: {A} {Tool} for {Calculating} {Minimum} {Detectable} {Effect} {Sizes} and {Minimum} {Required} {Sample} {Sizes} for {Experimental} and {Quasi}-{Experimental} {Design} {Studies}},
